# Copy this file to .env (or configure these as real environment variables)
# and fill in real values. Never commit the actual .env file.

# Active Spring profile: dev (H2, local) or prod (PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8081

# JWT
JWT_SECRET=replace-with-a-long-random-base64-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS - comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:4200

# PostgreSQL (required only when SPRING_PROFILES_ACTIVE=prod)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gymhubsa
SPRING_DATASOURCE_USERNAME=gymhubsa
SPRING_DATASOURCE_PASSWORD=change-me

# File storage (local dev path; swap for cloud storage config in prod later)
FILE_STORAGE_BASE_DIR=uploads

# Payment gateway webhook shared secret (replace with real gateway's signature scheme later)
PAYMENT_WEBHOOK_SECRET=change-this-webhook-secret
